        "char_start": 46,
        "char_end": 280,
        "byte_start": 46,
        "byte_end": 280,
        "text": "Combined MPLPB is a closed local ledger with tools for raw-material sorting,\nbounded source questions, documentary inspection and retained work history.\nIts browser, native CLI and agent adapters preserve the existing authority rules."
      },
      "assessment": {
        "status": "unassessed_candidate",
