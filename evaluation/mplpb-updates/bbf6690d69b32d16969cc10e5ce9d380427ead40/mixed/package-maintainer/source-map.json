        {
          "node_id": "node:ee634faf5561c1114cad579e3d03259906a4fc3419d76a25c5024736804e9b49",
          "occurrence_id": "node:ab9a992a745b4dab5508bb526ed3914594e01e4f1d1c5ef4b189d99430a83887",
          "span": {
            "source_id": "source:91a8e0141aeb222f8fca1eb3baf0958581d4012ca5ac405f96f9d6364f39e502",
            "source_sha256": "sha256:2501dd1b1751693d82088d8bad0096697f4b0dec3f151c596a5d240145508eeb",
            "path": "repo/docs/PASSAGE_ADMISSION.md",
            "char_start": 372,
            "char_end": 733,
            "byte_start": 372,
            "byte_end": 733,
            "text": "All admitted exact source ID/path/hash/half-open spans share the original passage and character limits. Repeated identical spans are charged once. Distinct nested spans and different revisions remain distinct. Multi-passage proofs must fit together; final assembly uses the same ledger. An independent final citation guard applies to other answer paths as well."
          },
          "review_status": "not_displayed_for_this_query",
          "candidate_links": [],
