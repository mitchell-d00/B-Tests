          "occurrence_id": "node:ab9a992a745b4dab5508bb526ed3914594e01e4f1d1c5ef4b189d99430a83887",
          "span": {
            "source_id": "source:91a8e0141aeb222f8fca1eb3baf0958581d4012ca5ac405f96f9d6364f39e502",
            "source_sha256": "sha256:2501dd1b1751693d82088d8bad0096697f4b0dec3f151c596a5d240145508eeb",
            "path": "repo/docs/PASSAGE_ADMISSION.md",
            "char_start": 1187,
            "char_end": 1628,
            "byte_start": 1187,
            "byte_end": 1628,
            "text": "Source-framed literal comparisons use a bounded reader discovery pass (at most32 records,6000-character prefix each,32 candidate pairs) and the existing comparison recognition rule to reserve content and framing witnesses. Fresh kernel verification remains required. This is a bounded existing grammar, not general historical semantic understanding. Native action and letter rules also reserve their multi-span dependencies by question part."
          },
          "review_status": "not_displayed_for_this_query",
          "candidate_links": [],
          "unresolved_references": []
        },
        {
