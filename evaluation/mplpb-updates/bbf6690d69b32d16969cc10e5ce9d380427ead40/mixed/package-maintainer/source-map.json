        },
        {
          "node_id": "node:da56ee167757fd45e448f28adeea26c2f5c84c0eff1b23853bc79f7e8afbb39c",
          "occurrence_id": "node:ab9a992a745b4dab5508bb526ed3914594e01e4f1d1c5ef4b189d99430a83887",
          "span": {
            "source_id": "source:91a8e0141aeb222f8fca1eb3baf0958581d4012ca5ac405f96f9d6364f39e502",
            "source_sha256": "sha256:2501dd1b1751693d82088d8bad0096697f4b0dec3f151c596a5d240145508eeb",
            "path": "repo/docs/PASSAGE_ADMISSION.md",
            "char_start": 735,
            "char_end": 1185,
            "byte_start": 735,
            "byte_end": 1185,
            "text": "Sorter classes explain inspection priority. Exact source ID/field/quote hints and explicit references/corrections can be considered for a relevant native question part. Shared wording and synonyms remain review-only; they receive no automatic slot or relationship traversal. Neither a class nor a ranking score bypasses source eligibility or verification. Optional API `source_hints` require exact pinned original locations and are non-authoritative."
          },
          "review_status": "not_displayed_for_this_query",
          "candidate_links": [],
          "unresolved_references": []
        },
        {
