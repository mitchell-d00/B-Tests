        {
          "node_id": "node:85d018f5d74fde47c41de7be276904a638a7470031b98788f2eb6f43fe8cdc2c",
          "occurrence_id": "node:57d5258b4f26c7a3b8ffcb2123b64a6645111a59a4b6caf6e925dac6148e9bf1",
          "span": {
            "source_id": "source:9792e7513ee2d54a2c8c5e4ce8230f1cb6b7866501af13c72acb49407ffb796a",
            "source_sha256": "sha256:071ab79efc9ebf996702ee4f8398612f395307258b5f295d0d9b1b2e239a1e30",
            "path": "repo/docs/CANDIDATE_REVIEW_WORKSPACE.md",
            "char_start": 1071,
            "char_end": 1546,
            "byte_start": 1072,
            "byte_end": 1547,
            "text": "Use `--topic 'lunar lichens'` for exploration without a question, or alongside a question to explore a different topic. Use `--profile internal`, `lab` or `external`; optional `--as-of` reuses the native serving view. The ledger must be a directly resolved collection of native originals. The workspace does not import, revise, retire or approve any source, follow external links or invoke a model. Outputs must be new files outside processed sources and the original ledger."
          },
          "review_status": "unmatched_or_unresolved_within_search_limits",
          "candidate_links": [],
          "unresolved_references": []
        },
        {
